APP_NAME="Snakes & Liquor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/snakesandliquor/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=snakesandliquor
DB_USERNAME=root
DB_PASSWORD=

# Sessions identify online players (no accounts) and the file cache provides the
# per-room action lock, so keep both on "file" — no extra tables needed.
SESSION_DRIVER=file
SESSION_LIFETIME=720
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# First admin, created by `php artisan db:seed` (change these before deploying!).
SNL_ADMIN_NAME="Admin"
SNL_ADMIN_EMAIL=admin@snakesandliquor.test
SNL_ADMIN_PASSWORD=change-me-now

MAIL_MAILER=log

SNL_PUBLIC_URL=https://snakesandliquor.co.ke
SNL_GA4_ID=
SNL_CONTACT_EMAIL=

# Google AdSense publisher id (ca-pub-...). Empty = no ads. Set only after AdSense approves the site.
SNL_ADSENSE_ID=
SNL_ADS_MIN_GAP=180
SNL_ADS_FREE_GAMES=1
